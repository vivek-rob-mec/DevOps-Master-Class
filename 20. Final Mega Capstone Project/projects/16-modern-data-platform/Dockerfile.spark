FROM eclipse-temurin:17-jre-jammy
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip && rm -rf /var/lib/apt/lists/* && groupadd -g 10001 platform && useradd -u 10001 -g platform --no-create-home platform
RUN pip3 install --no-cache-dir pyspark==4.0.3
WORKDIR /opt/platform
COPY --chown=platform:platform jobs/ jobs/
COPY --chown=platform:platform data/ data/
USER 10001:10001
CMD ["python3","jobs/order_metrics.py"]
